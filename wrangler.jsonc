{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soglia-site",
  "compatibility_date": "2026-05-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "routes": [
    {
      "pattern": "soglia.trelune.dev",
      "custom_domain": true
    }
  ]
}
